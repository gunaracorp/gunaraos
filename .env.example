# ═══════════════════════════════════════════════════════════════
# 🗄️  GUNARA OS — Contoh Konfigurasi Database
#     Copy file ini menjadi .env lalu sesuaikan
# ═══════════════════════════════════════════════════════════════

# ── MODE LOKAL (default, aktif sekarang) ──────────────────────
# Database SQLite berbentuk file di dalam proyek.
DATABASE_URL="file:/home/z/my-project/db/custom.db"

# ── MODE CLOUD — Prisma Postgres di prisma.io (FREE, tanpa kartu kredit) ──
# 1. Daftar  : https://console.prisma.io  (login pakai GitHub)
# 2. Create  : New project → Prisma Postgres → pilih region terdekat
# 3. Copy    : connection string (postgres://...@db.prisma.io:5432/...)
# 4. Paste   : di baris di bawah ini, buang tanda # di depannya
# 5. Jalankan: bash scripts/db-migrate-cloud.sh  (push tabel + pindahkan data)
#    atau     : bun run db:cloud:push             (push tabel saja)
#
# PRISMA_POSTGRES_URL="postgres://user:password@db.prisma.io:5432/postgres?sslmode=require"
#
# 📊 Free tier prisma.io: 2 GB storage · 200.000 operations/bulan
#    (~6.600 query/hari) · 50 database · idle = 0 biaya
#
# Kembali ke mode lokal: hapus/komentari PRISMA_POSTGRES_URL lalu
# jalankan: bun run db:cloud:off
