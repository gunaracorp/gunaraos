generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════
// 🌊 HULU — Diisi sekali, dibaca tiap Senin
// ═══════════════════════════════════════════════════════

model Setting {
  key   String @id
  value String
}

// ═══════════════════════════════════════════════════════
// ⚙️ MESIN 1 — KEUANGAN
// ═══════════════════════════════════════════════════════

model Debt {
  id              String        @id @default(cuid())
  tanggal         String        @default("")
  kepada          String
  nilaiAwal       Float         @default(0)
  cicilanPerBulan Float         @default(0)
  tenggat         String        @default("")
  prioritas       String        @default("RINGAN") // BUNGA-TINGGI | TENGGAT-DEKAT | RINGAN
  status          String        @default("AKTIF") // AKTIF | LUNAS | NEGOSIASI
  catatan         String        @default("")
  payments        DebtPayment[]
  createdAt       DateTime      @default(now())
}

model DebtPayment {
  id        String   @id @default(cuid())
  debtId    String
  debt      Debt     @relation(fields: [debtId], references: [id], onDelete: Cascade)
  tanggal   String   @default("")
  jumlah    Float    @default(0)
  catatan   String   @default("")
  createdAt DateTime @default(now())
}

model Receivable {
  id           String   @id @default(cuid())
  klien        String
  proyek       String   @default("")
  nilaiKontrak Float    @default(0)
  dpDiterima   Float    @default(0)
  jatuhTempo   String   @default("")
  status       String   @default("MENUNGGU") // LUNAS | MENUNGGU | TERLAMBAT | MACET
  catatan      String   @default("")
  createdAt    DateTime @default(now())
}

model Cashflow {
  id         String   @id @default(cuid())
  tanggal    String   @default("")
  jenis      String   @default("MASUK") // MASUK | KELUAR
  pt         String   @default("DIGIMAN") // TKI | DIGIMAN | PRIBADI
  kategori   String   @default("")
  nilai      Float    @default(0)
  keterangan String   @default("")
  createdAt  DateTime @default(now())
}

model ChildSaving {
  id        String   @id @default(cuid())
  tanggal   String   @default("")
  nilai     Float    @default(0)
  catatan   String   @default("")
  createdAt DateTime @default(now())
}

// ═══════════════════════════════════════════════════════
// ⚙️ MESIN 2 — KLIEN / CRM
// ═══════════════════════════════════════════════════════

model Client {
  id                String     @id @default(cuid())
  nama              String
  kontak            String     @default("")
  segmen            String     @default("UMKM") // UMKM | PRODUSEN | PMA | BIRO | LAINNYA
  layanan           String     @default("")
  status            String     @default("PIPIN") // PIPIN | NEGOSIASI | KLIEN | RETAINER | ARSIP
  nilaiTotal        Float      @default(0)
  sumber            String     @default("")
  tglKontakTerakhir String     @default("")
  catatan           String     @default("")
  followUps         FollowUp[]
  createdAt         DateTime   @default(now())
}

model FollowUp {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tindakan  String
  tenggat   String   @default("")
  status    String   @default("TERJADWAL") // TERJADWAL | SELESAI | TELAT
  hasil     String   @default("")
  createdAt DateTime @default(now())
}

// ═══════════════════════════════════════════════════════
// ⚙️ MESIN 3 — RELASI & POLITIK
// ═══════════════════════════════════════════════════════

model Relation {
  id             String   @id @default(cuid())
  nama           String
  domainRelasi   String   @default("Bisnis") // PPP | Bisnis | Pemerintahan | Media | Agama
  kekuatan       String   @default("AKTIVIS") // TOKOH | PENGARUH | AKTIVIS | CALON KLIEN
  sayaBantu      String   @default("")
  diaBantu       String   @default("")
  kontakTerakhir String   @default("")
  prioritas      String   @default("B") // A | B | C
  catatan        String   @default("")
  createdAt      DateTime @default(now())
}

model PoliticalActivity {
  id         String   @id @default(cuid())
  tanggal    String   @default("")
  kegiatan   String
  peran      String   @default("")
  relasiBaru String   @default("")
  peluang    String   @default("")
  createdAt  DateTime @default(now())
}

// ═══════════════════════════════════════════════════════
// ⚙️ MESIN 4 — BELAJAR
// ═══════════════════════════════════════════════════════

model LearningJournal {
  id          String   @id @default(cuid())
  tanggal     String   @default("")
  judul       String
  dipelajari  String   @default("")
  mengejutkan String   @default("")
  bisaDipakai String   @default("")
  jadiKonten  String   @default("")
  createdAt   DateTime @default(now())
}

// ═══════════════════════════════════════════════════════
// ⚙️ MESIN 5 — DOKUMENTASI KEMENANGAN
// ═══════════════════════════════════════════════════════

model WinLog {
  id         String   @id @default(cuid())
  tanggal    String   @default("")
  kemenangan String
  bukti      String   @default("")
  jadiKonten String   @default("")
  createdAt  DateTime @default(now())
}

model CaseStudy {
  id        String   @id @default(cuid())
  judul     String
  klien     String   @default("")
  masalah   String   @default("")
  langkah   String   @default("")
  hasil     String   @default("")
  testimoni String   @default("")
  buktiLink String   @default("")
  createdAt DateTime @default(now())
}

// ═══════════════════════════════════════════════════════
// 🏃 HILIR — Ritme Operasi Harian
// ═══════════════════════════════════════════════════════

model DailyLog {
  id        String   @id @default(cuid())
  tanggal   String   @unique
  mit1      String   @default("")
  mit2      String   @default("")
  mit3      String   @default("")
  done1     Boolean  @default(false)
  done2     Boolean  @default(false)
  done3     Boolean  @default(false)
  refleksi  String   @default("")
  energi    Int      @default(5)
  createdAt DateTime @default(now())
}

model WeeklyReview {
  id         String   @id @default(cuid())
  minggu     String
  mitSelesai Int      @default(0)
  mitTotal   Int      @default(21)
  leads      Int      @default(0)
  ditindak   Int      @default(0)
  closing    Int      @default(0)
  progres    String   @default("")
  energi     Int      @default(5)
  hentikan   String   @default("")
  janji      String   @default("")
  target     String   @default("")
  fokus1     String   @default("")
  fokus2     String   @default("")
  fokus3     String   @default("")
  jadwalAnak String   @default("")
  createdAt  DateTime @default(now())
}

model BacklogItem {
  id        String   @id @default(cuid())
  tanggal   String   @default("")
  ide       String
  kenapa    String   @default("")
  ditinjau  String   @default("")
  status    String   @default("MENUNGGU") // MENUNGGU | NAIK PRIORITAS | CORET
  createdAt DateTime @default(now())
}

model DecisionLog {
  id        String   @id @default(cuid())
  tanggal   String   @default("")
  keputusan String
  alasan    String   @default("")
  hasil     String   @default("")
  createdAt DateTime @default(now())
}

// ═══════════════════════════════════════════════════════
// 🛡️ ARSENAL — Domain Portfolio & AI Agent Army
// ═══════════════════════════════════════════════════════

model Domain {
  id      String  @id @default(cuid())
  nama    String  @unique
  tier    String  @default("PARKED") // INTI | GATEWAY | FUTURE | PARKED
  peran   String  @default("")
  status  String  @default("PLAN")
  catatan String  @default("")
  urutan  Int     @default(0)
}

model Agent {
  id        String   @id @default(cuid())
  nomor     Int      @default(0)
  nama      String
  platform  String   @default("")
  gelombang Int      @default(1)
  tupoksi   String   @default("")
  prompt    String   @default("")
}
